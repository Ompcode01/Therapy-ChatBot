# Copy this file to .env and fill in your real values.
# On Replit, you can also store these in the Secrets tab — both work the same way.

# Required for the chatbot to talk to the Groq LLM
GROQ_API_KEY=your_groq_api_key_here

# Optional – only needed if/when you wire up the FastAPI backend + Postgres
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# SECRET_KEY=replace_with_a_long_random_string
